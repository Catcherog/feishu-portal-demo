# =============================================================================
# Portal 环境变量配置示例
# 复制为 .env.local 并按需修改
# =============================================================================

# ----------------------------------------------------------------------------
# API 模式控制（必填，AC-A03 / FAMP-PORTAL-VERCEL-LOCAL-RUNTIME-01 §2）
#
# 决定 Portal 使用本地 mock 数据还是调用真实 collator HTTP 服务。
# - true  : Demo / Mock 模式，使用本地模拟数据，不调用 collator
# - false : Real 模式，调用真实 collator HTTP 服务
#
# 安全约束（amendment 3）：
# - 生产构建（NODE_ENV=production）时此变量必须显式设置
# - 缺失时生产构建直接报错，不得静默进入 Demo 模式
# - 开发环境缺失时默认 mock 并 console.warn 提示
NEXT_PUBLIC_DEMO_MODE=false

# ----------------------------------------------------------------------------
# collator HTTP 服务地址（real 模式调用）
# FAMP-PORTAL-VERCEL-LOCAL-RUNTIME-01: 使用 127.0.0.1 而非 localhost
# 仅在 NEXT_PUBLIC_DEMO_MODE=false 时生效
# 默认值: http://127.0.0.1:8787
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# ----------------------------------------------------------------------------
# 运行时模式（FAMP-PORTAL-VERCEL-LOCAL-RUNTIME-01 §2）
# - local-companion: 同机模式，Collator/SOP 在本机运行
# - demo: 演示模式，不连接本地服务
NEXT_PUBLIC_RUNTIME_MODE=local-companion

# ----------------------------------------------------------------------------
# 写入模式（FAMP-PORTAL-VERCEL-LOCAL-RUNTIME-01 §2）
# - controlled: 受控写入，需人工确认和执行
# - dry-only: 仅干运行，不实际写入
NEXT_PUBLIC_WRITE_MODE=controlled
